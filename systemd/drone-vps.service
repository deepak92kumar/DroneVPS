[Unit]
# The VPS node: flow, map fixes, fusion, and the GPS_INPUT injection.
Description=DroneVPS node (flow + map matching + GPS_INPUT)
After=drone-router.service
# The map, the weights and this script are all on the NVMe.
RequiresMountsFor=/data/DRONE
Requires=drone-router.service

[Service]
Type=simple
User=abc
WorkingDirectory=/data/DRONE/vps_vio
# Rewritten 20 Oct. What was here passed --gps2, which live_node has never
# had: the unit died on an argparse error the instant it started, and with
# Restart=always in front of it, it did that every five seconds for ever. The
# service could not have worked on any boot. It was also missing --map,
# --fc-port and --send-gps, so even with the flag accepted it would have sat
# there matching nothing against nothing and sending nowhere.
#
# --out is a DIRECTORY, so every run gets its own numbered file. Without it the
# flying service recorded nothing at all: after a flight there was only the FC's
# own dataflash, which knows what we SENT but nothing about why we sent it - no
# sigma, no track count, no velocity-bridge state. The 8 Oct collapse could not
# be diagnosed for exactly that reason.
#
# --save-frames 4 was added 20 Oct, after the day's flight produced a CSV and
# not one image: the flag is off by default and this unit did not pass it, so
# frame_writer had never run on a flight. 4 Hz at the pilot's asking. Measured
# cost: offer() 0.158 ms on the loop thread, the encode 10.4 ms on the worker
# (= 4.2% of one core at 4 Hz), 123 KB a frame, so ~1.8 GB an hour against
# 929 GB free. With this flag the run becomes a FOLDER - the CSV, the jpgs,
# camera.txt and the camera IMU log in one place.
#
# --fc-port goes through the router, not at the serial device: the router is
# the one owner of /dev/ttyTHS1 and everything else is a UDP client of it.
# --send-gps with --gps-id 1 is what makes the estimate arrive as GPS2.
#
# --map IS maps/active.tif AND MUST STAY THAT WAY. That path is the symlink
# Studio repoints when the pilot loads a sheet (studio/flightsheet.py: "Point
# maps/active.tif at this sheet"), so it is the one name that follows the
# aircraft to a new site. A sheet named here directly does not.
#
# 1 NOV, flight 378, is why. The pilot loaded bam1.tif in Studio at 15:36 and
# Studio did its job - maps/active.tif pointed at demo/bam1.tif, which covers
# the site. This line still said demo_loc.tif, so the node opened the old
# sheet, whose bounds (lon 74.0945-74.1195) do not contain the take-off point
# at 74.1254. MapFixWorker's covers() was false for the whole flight, the
# matcher never ran once, and every fix_*/try_* column in all 18225 rows of
# vps_00378.csv is null. The RC showed f0 for 764 s and the drone flew the
# entire VPS leg on flow alone.
#
# The installed unit said demo_bam1.tif, which is a symlink to the SAME old
# sheet - a name that reads like the right map and is not. That symlink is
# deleted; use maps/active.tif.
ExecStart=/usr/bin/python3 /data/DRONE/vps_vio/live_node.py \
    --live \
    --map /data/DRONE/maps/active.tif \
    --fc-port udpout:127.0.0.1:14650 \
    --send-gps --gps-id 1 \
    --out /data/DRONE/flight_logs/vps \
    --save-frames 4 \
    --liveness /run/drone/vps.alive
Restart=always
RestartSec=5
# Exit 3 is single_instance's "someone else already holds it". Restarting on
# that is pointless and noisy - the other copy is doing the job - so systemd
# steps aside instead of looping. Every other failure still restarts.
RestartPreventExitStatus=3
# /run/drone, owned by this user, created at start and cleaned up at stop.
# The liveness file and the watchdog's state both live there.
RuntimeDirectory=drone
RuntimeDirectoryMode=0755
# Restart= catches a crash. It does NOT catch a loop stuck on a camera frame,
# which is what the liveness file above and drone-watchdog.timer are for.
StandardOutput=append:/data/DRONE/flight_logs/vps_stdout.log
StandardError=append:/data/DRONE/flight_logs/vps_stderr.log

[Install]
WantedBy=multi-user.target
