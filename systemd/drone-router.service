[Unit]
# Owns /dev/ttyTHS1 alone and hands it out over UDP. Everything else that
# wants the flight controller is a client of this, which is what removes the
# "two readers split one stream" failure that vps_vio/fc_port.py worked around
# by stopping the recorder.
Description=MAVLink router - sole owner of the FC serial line
# NOT After=multi-user.target. This unit is WantedBy=multi-user.target, so
# ordering itself after that target closes a loop: the target pulls in
# drone-vps, drone-vps is After this, and this is After the target. systemd
# breaks such a loop by DELETING jobs, and on 20 Oct it deleted exactly the
# two that matter:
#
#   multi-user.target: Found ordering cycle on drone-vps.service/start
#   multi-user.target: Found dependency on drone-router.service/start
#   Job drone-vps.service/start deleted to break ordering cycle
#   ... and the same for drone-rc-switch.service
#
# So the router came up alone after every reboot and nothing else did, with
# no error and no failed unit - the two services were simply never attempted.
# That is the field failure the pilot described: the aircraft and the Jetson
# were restarted and the VPS never came back.
After=network.target
# The programs, the map and the logs all live on the NVMe. Without this the
# unit can be started before /data is mounted, which fails for a reason that
# has nothing to do with the program.
RequiresMountsFor=/data/DRONE
Before=drone-vps.service drone-rc-switch.service

[Service]
Type=simple
User=abc
# The port is root:dialout. usermod alone does not help a service, which gets
# its groups fresh at start, so name the group here.
SupplementaryGroups=dialout
WorkingDirectory=/data/DRONE
# 921600 is what the FC flies: SERIAL2_BAUD reads 921 in log 00000195.BIN.
ExecStart=/usr/bin/python3 /data/DRONE/mavlink_router.py \
    --port /dev/ttyTHS1 --baud 921600 --listen 127.0.0.1:14650
Restart=always
RestartSec=2
# Exit 3 is single_instance's 'another copy holds it'. Looping on that
# achieves nothing, so systemd stands down instead.
RestartPreventExitStatus=3
# /run/drone, owned by abc, created at start and removed on stop. The liveness
# file and the watchdog state live here rather than /tmp.
RuntimeDirectory=drone
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
