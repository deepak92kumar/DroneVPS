# Stop the OAK-D's USB 3 link dropping into U1/U2, which is what takes it off
# the bus mid-flight.
#
# The kernel logs
#     xhci-hcd: Disable of device-initiated U1/U2 failed
# immediately before each disconnect. Measured 3 Nov with the aircraft
# disarmed and standing still indoors: two drops in 45 minutes, at 19:46 and
# 20:24, each one taking the camera off the bus for 6-13 s. On the ground that
# is a line in a log; in the air it is the node restarting, and with the camera
# init and the XFeat load that is twenty to thirty seconds with no injection.
# So it is not vibration and it is not the cable - the 1 m cable was swapped
# for a 15 cm one on 3 Nov and the drops continued, though the U1/U2 message
# itself stopped.
#
# FIRST VERSION OF THIS FILE DID NOT WORK, and the correction is the point:
# it wrote to power/usb3_hardware_lpm_u1 and u2 on the DEVICE. Those are
# DEVICE_ATTR_RO - permission 444 - so udev silently changed nothing and both
# still read "enabled" after a reload and a trigger.
#
# The writable control is usb3_lpm_permit on the PORT, not the device:
#
#     /sys/bus/usb/devices/<dev>/port/usb3_lpm_permit     rw-r--r--
#     values: 0 (neither), u1, u2, u1_u2 (the default, and what every port
#     on this Jetson reads)
#
# Matching the port by name would pin this to one physical socket. Instead the
# rule matches the CAMERA by its vendor id and follows the device's own port
# link, so it keeps working whichever socket the camera is plugged into.
#
# 03e7:2485 is the MyriadX unbooted, 03e7:f63b the same chip after DepthAI has
# booted it; the device re-enumerates between the two, so both need the rule.
#
# Install:
#     sudo cp etc/99-oakd-no-usb3-lpm.rules /etc/udev/rules.d/
#     sudo udevadm control --reload
#     sudo udevadm trigger --action=add --subsystem-match=usb --attr-match=idVendor=03e7
# Check (expect 0, not u1_u2):
#     cat /sys/bus/usb/devices/2-1.2/port/usb3_lpm_permit

ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="03e7", ATTR{idProduct}=="2485", \
  RUN+="/bin/sh -c 'echo 0 > /sys%p/port/usb3_lpm_permit 2>/dev/null || true'"

ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="03e7", ATTR{idProduct}=="f63b", \
  RUN+="/bin/sh -c 'echo 0 > /sys%p/port/usb3_lpm_permit 2>/dev/null || true'"
