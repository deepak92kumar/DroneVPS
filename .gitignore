# Source-only checkpoint: large/binary/live data excluded (full tarball in /mnt/ssd/DRONE_backups)
flight_images/
flight_logs/
.cursor/
.cache/
__pycache__/
*.bin
*.jpg
*.png
*.pdf
*.log
*.csv
*.tmp
.~lock*
*.bak_*

# Rewritten by flight_daemon.py every 10 s (runtime output, not source)
latest_flight_summary.txt
flights/
flights/analysis/*.png

# Third-party checkouts: pinned in third_party/README.md, not committed
third_party/*
!third_party/README.md

# Satellite GeoTIFFs: large, and a 3.7 GB directory in an early commit is
# what blocked the push on 28 Sep and cost 27 commits.
*.tif
*.tiff

# Flight recordings: images and logs, kept outside git
flights/

# Chat transcripts: backed up locally, deliberately NOT committed.
# 26 MB of full conversation. See HANDOFF_2026-10-22.md, "Chat backup".
chat_backup/

# Status reports are the project record and belong in it; other PDFs do not.
!DroneVPS_Status_*.pdf
