# DroneVPS - what to put back after the FC hard reset.
# Built from the 238/286 parameter snapshot, which is a
# configuration that flew with no failsafe, plus the five
# speeds changed on 30 Oct.
#
# NOT in here, on purpose: accelerometer, compass and RC
# calibration. Those are physical and belong to a sensor on a
# day, not to a file - do them on the aircraft.


# 1. THE LINK - this one first, over USB, or telem2 stays dead
SERIAL2_PROTOCOL,2
SERIAL2_BAUD,921
SERIAL2_OPTIONS,0
SERIAL1_PROTOCOL,2
SERIAL1_BAUD,57
SERIAL3_PROTOCOL,5
SERIAL3_BAUD,230
SERIAL4_PROTOCOL,5
SERIAL4_BAUD,115
SERIAL5_PROTOCOL,-1
SERIAL6_PROTOCOL,-1
SERIAL7_PROTOCOL,2
SERIAL7_BAUD,115200

# 2. THE AIRFRAME
FRAME_CLASS,2
FRAME_TYPE,1

# 3. BATTERY - the pins and multipliers are this board's, not defaults
BATT_MONITOR,4
BATT_VOLT_PIN,16
BATT_CURR_PIN,17
BATT_VOLT_MULT,17.88
BATT_AMP_PERVLT,24
BATT_CAPACITY,16000
BATT_ARM_VOLT,23.3
BATT_LOW_VOLT,21
BATT_CRT_VOLT,20.4
BATT_FS_LOW_ACT,0
BATT_FS_CRT_ACT,0

# 4. HARMONIC NOTCH - tuned for this airframe, lost in the reset
INS_HNTCH_ENABLE,1
INS_HNTCH_MODE,1
INS_HNTCH_FREQ,47
INS_HNTCH_BW,24
INS_HNTCH_REF,0.331
INS_HNTCH_HMNCS,3
INS_HNTCH_ATT,40
INS_HNTCH_FM_RAT,1
INS_HNTCH_OPTS,0

# 5. GPS AND THE VPS INJECTION - GPS2 is where our estimate arrives
GPS_PRIMARY,1
GPS2_TYPE,14
GPS_AUTO_SWITCH,0
GPS_AUTO_CONFIG,1
GPS1_DELAY_MS,0
GPS2_DELAY_MS,0
GPS1_RATE_MS,200
GPS2_RATE_MS,200
GPS2_POS_X,0
GPS2_POS_Y,0
GPS2_POS_Z,0.22

# 6. EKF SOURCES - what the estimate is actually built from
AHRS_EKF_TYPE,3
EK3_ENABLE,1
EK3_SRC1_POSXY,3
EK3_SRC1_VELXY,3
EK3_SRC1_POSZ,1
EK3_SRC1_VELZ,0
EK3_SRC1_YAW,1
EK3_SRC2_POSXY,0
EK3_SRC2_VELXY,0
EK3_SRC_OPTIONS,0
EK3_GLITCH_RAD,25
EK3_POSNE_M_NSE,0.5
EK3_VELNE_M_NSE,0.3
EK3_VELD_M_NSE,0.5
EK3_GPS_CHECK,0

# 7. FAILSAFE - FS_OPTIONS bit 0 is what lets a WP mission continue through an RC failsafe
FS_THR_ENABLE,1
FS_THR_VALUE,975
FS_OPTIONS,17
FS_GCS_ENABLE,0
FS_GCS_TIMEOUT,5
FS_EKF_ACTION,2
FS_EKF_THRESH,1.2
FS_EKF_FILT,5
FS_CRASH_CHECK,1
FS_VIBE_ENABLE,1
FS_DR_ENABLE,2
FS_DR_TIMEOUT,30
RC_FS_TIMEOUT,1

# 8. SPEEDS - as set on 30 Oct, not as flown on 27 Oct
WP_SPD,3      # 30 Oct, not the 27 Oct value
WP_SPD_UP,1.5      # 30 Oct, not the 27 Oct value
WP_SPD_DN,1.1      # 30 Oct, not the 27 Oct value
WP_ACC,2.5
WP_ACC_Z,1
WP_JERK,1
WP_RADIUS_M,2
WP_YAW_BEHAVIOR,2
WP_RFND_USE,1
WP_NAVALT_MIN,0
LOIT_SPEED_MS,3      # 30 Oct, not the 27 Oct value
LOIT_ACC_MAX_M,2.62768
PILOT_SPD_UP,1.5      # 30 Oct, not the 27 Oct value
PILOT_SPD_DN,0
PILOT_ACC_Z,2.5
PILOT_Y_RATE,45
ACRO_Y_RATE,45
LAND_SPD_MS,0.5
LAND_SPD_HIGH_MS,0
LAND_ALT_LOW_M,10
LAND_REPOSITION,1
RTL_ALT_M,15
RTL_ALT_FINAL_M,0
RTL_ALT_TYPE,0
RTL_SPEED_MS,0

# 9. RANGEFINDER - off, and it has to stay off until the lidar is back
RNGFND1_TYPE,0

# 10. THE ORIGIN THE VPS FLIES FROM - retype SCR_USER1/2 at the new site
SCR_ENABLE,1
SCR_USER1,30.555281000      # the DEMO site, not the old one
SCR_USER2,74.104889000      # the DEMO site, not the old one
SCR_USER3,193

# 11. RC AND FLIGHT MODES - RC6 1045/1945 is the GPS/VPS switch
RC_PROTOCOLS,1
RC_OPTIONS,32
FLTMODE_CH,5
FLTMODE1,5
FLTMODE2,2
FLTMODE3,5
FLTMODE4,2
FLTMODE5,5
FLTMODE6,6
RC6_OPTION,0
RC6_MIN,1045
RC6_MAX,1945
RC6_TRIM,1045
RC6_DZ,0
RC6_REVERSED,0

# 12. PRECISION LANDING - enabled, but nothing feeds it since 26 Sep
PLND_ENABLED,1
PLND_TYPE,1
PLND_EST_TYPE,1
PLND_ALT_MIN,0.75
PLND_ALT_MAX,0
PLND_XY_DIST_MAX,2.5
PLND_STRICT,1
PLND_TIMEOUT,4
PLND_RET_MAX,4
PLND_LAG,0.03
PLND_ACC_P_NSE,2.5
PLND_BUS,-1
